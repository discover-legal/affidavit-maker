{
  "name": "affidavit-maker-client",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@auth0/auth0-react": "^2.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "lodash": "^4.17.22",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "craco start",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "craco build",
    "build:seo": "craco build && react-snap",
    "test": "craco test",
    "eject": "react-scripts eject",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "proxy": "http://localhost:3001",
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0"
  },
  "overrides": {
    "minimist": "^1.2.8",
    "mkdirp": "^1.0.4"
  },
  "reactSnap": {
    "include": [
      "/",
      "/resources",
      "/resources/how-to-write-an-affidavit",
      "/resources/persuasive-legal-writing-guide",
      "/resources/texas-family-law-affidavits",
      "/resources/notarization-explained",
      "/resources/utah-legal-documents-guide",
      "/resources/arizona-affidavit-requirements",
      "/privacy",
      "/tos",
      "/brand"
    ],
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--disable-software-rasterizer",
      "--single-process"
    ],
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    }
  }
}
