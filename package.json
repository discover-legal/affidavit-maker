{
  "name": "affidavit-maker",
  "version": "3.0.0",
  "description": "Professional affidavit generation tool with enhanced validation and resilience",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "monitor": "node scripts/monitor.js",
    "analyze": "node scripts/analyze-bundle.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "openai": "^4.104.0",
    "pg": "^8.16.3",
    "puppeteer": "^21.11.0",
    "rate-limit-redis": "^4.2.1",
    "react-router-dom": "^7.8.1",
    "stripe": "^14.25.0",
    "uuid": "^9.0.1",
    "web-vitals": "^5.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourcompany/affidavit-maker.git"
  },
  "keywords": [
    "affidavit",
    "legal",
    "document",
    "generation",
    "ai",
    "openai",
    "validation"
  ],
  "author": "Your Company",
  "license": "None. All rights reserved.",
  "bugs": {
    "url": "https://discover.legal"
  },
  "homepage": "https://discover.legal"
}
