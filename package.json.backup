{
  "name": "affidavit-maker",
  "version": "1.0.0",
  "description": "AI-powered affidavit generation system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "migrate": "node scripts/migrate.js",
    "migrate:indexes": "node scripts/migrations/add-missing-indexes.js",
    "clean:logs": "node scripts/cleanLogs.js",
    "clean:pdfs": "node scripts/cleanPdfs.js",
    "analyze": "node scripts/analyze.js",
    "deploy": "bash scripts/deploy.sh"
  },
  "keywords": [
    "affidavit",
    "legal",
    "document",
    "ai",
    "openai",
    "auth0",
    "stripe"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "openai": "^4.104.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "puppeteer": "^21.6.0",
    "stripe": "^13.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
