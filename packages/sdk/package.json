{
  "name": "@discover-legal/sdk",
  "version": "0.1.0",
  "description": "Typed client for the discover.legal document marketplace API",
  "license": "UNLICENSED",
  "homepage": "https://discover.legal",
  "repository": {
    "type": "git",
    "url": "https://github.com/discover-legal/affidavit-maker.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "openapi.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "npx -y openapi-typescript@^7 openapi.yaml -o src/generated/schema.d.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "restricted",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./openapi.yaml": "./openapi.yaml"
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "discover.legal",
    "legal",
    "marketplace",
    "sdk",
    "api-client"
  ]
}
