    "caseNumberLabel": "Index No.:",
    "custody": "Custody",
    "physicalCustody": "Physical Custody",
    "jointCustody": "Joint Custody",
    "soleCustody": "Sole Custody",
    "visitation": "Parenting Time/Visitation",
    "alimony": "Maintenance",
    "maritalProperty": "Marital Property",
    "court": "Supreme Court"
  },

  "officialForms": {
    "summons": {
      "formNumber": "UD-1/UD-1a",
      "name": "Summons with Notice",
      "required": true
    },
    "automaticOrders": {
      "name": "Notice of Automatic Orders",
      "required": true,
      "notes": "Must be served with summons"
    },
    "healthCareNotice": {
      "name": "Notice of Health Care Coverage",
      "required": true
    },
    "complaint": {
      "formNumber": "UD-2",
      "name": "Verified Complaint",
      "required": true
    },
    "affidavitOfService": {
      "formNumber": "UD-3",
      "name": "Affidavit of Service",
      "required": true
    },
    "barriersStatement": {
      "formNumber": "UD-4",
      "name": "Sworn Statement of Removal of Barriers to Remarriage",
      "required": false,
      "whenRequired": "religious_ceremony",
      "notes": "Must be served if married in religious ceremony"
    },
    "barriersService": {
      "formNumber": "UD-4a",
      "name": "Affidavit of Service of UD-4",
      "required": false
    },
    "affirmationOfRegularity": {
      "formNumber": "UD-5",
      "name": "Affirmation of Regularity",
      "required": true
    },
    "affidavitOfPlaintiff": {
      "formNumber": "UD-6",
      "name": "Affidavit of Plaintiff",
      "required": true
    },
    "affidavitOfDefendant": {
      "formNumber": "UD-7",
      "name": "Affidavit of Defendant",
      "required": false,
      "whenRequired": "agreed/uncontested"
    },
    "incomeWorksheet": {
      "formNumber": "UD-8(1)",
      "name": "Annual Income Worksheet",
      "required": true,
      "whenRequired": "support_requested"
    },
    "maintenanceWorksheet": {
      "formNumber": "UD-8(2)",
      "name": "Maintenance Guidelines Worksheet",
      "required": true,
      "whenRequired": "maintenance_requested"
    },
    "childSupportWorksheet": {
      "formNumber": "UD-8(3)",
      "name": "Child Support Worksheet",
      "required": true,
      "whenRequired": "minor_children"
    },
    "supportCollection": {
      "formNumber": "UD-8a",
      "name": "Support Collection Unit Information",
      "required": true,
      "whenRequired": "support_ordered"
    },
    "qmcso": {
      "formNumber": "UD-8b",
      "name": "Qualified Medical Child Support Order",
      "required": false
    },
    "noteOfIssue": {
      "formNumber": "UD-9",
      "name": "Note of Issue",
      "required": true
    },
    "findingsOfFact": {
      "formNumber": "UD-10",
      "name": "Findings of Fact and Conclusions of Law",
      "required": true
    },
    "judgment": {
      "formNumber": "UD-11",
      "name": "Judgment of Divorce",
      "required": true
    },
    "part130": {
      "formNumber": "UD-12",
      "name": "Part 130 Certification",
      "required": true
    },
    "rji": {
      "formNumber": "UD-13",
      "name": "Request for Judicial Intervention (RJI)",
      "required": true
    },
    "noticeOfEntry": {
      "formNumber": "UD-14",
      "name": "Notice of Entry",
      "required": true
    },
    "serviceOfJudgment": {
      "formNumber": "UD-15",
      "name": "Affidavit of Service by Mail of Judgment",
      "required": true
    },
    "divorceSummary": {
      "formNumber": "UCS-111",
      "name": "Divorce and Child Support Summary Form",
      "required": true
    },
    "rjiAddendum": {
      "formNumber": "UCS-840M",
      "name": "Addendum to Request for Judicial Intervention",
      "required": true
