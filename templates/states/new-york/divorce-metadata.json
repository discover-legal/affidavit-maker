  "residencyRequirements": {
    "options": [
      {
        "code": "two_years",
        "yearsRequired": 2,
        "description": "Either spouse lived in New York for 2 continuous years before filing"
      },
      {
        "code": "one_year_married_in_ny",
        "yearsRequired": 1,
        "additionalRequirement": "Parties were married in New York",
        "description": "Either spouse lived in NY for 1 year AND were married in NY"
      },
      {
        "code": "one_year_lived_in_ny",
        "yearsRequired": 1,
        "additionalRequirement": "Parties once lived as married couple in NY",
        "description": "Either spouse lived in NY for 1 year AND once lived as married in NY"
      },
      {
        "code": "one_year_cause_in_ny",
        "yearsRequired": 1,
        "additionalRequirement": "Cause of action arose in NY",
        "description": "Either spouse lived in NY for 1 year AND grounds arose in NY"
      },
      {
        "code": "both_live_cause_in_ny",
        "yearsRequired": 0,
        "additionalRequirement": "Both live in NY and cause arose in NY",
        "description": "Grounds arose in NY AND both currently live in state"
      }
    ],
    "statute": "DRL § 230"
  },

  "waitingPeriod": {
    "days": 0,
    "noFaultRequirement": {
      "months": 6,
      "description": "For no-fault divorce, marriage must be irretrievably broken for at least 6 months"
    },
    "description": "No mandatory waiting period after filing, but no-fault ground requires 6-month breakdown period"
  },

  "groundsForDivorce": {
    "noFault": [
      {
        "code": "irretrievable_breakdown",
        "name": "Irretrievable Breakdown",
        "description": "Relationship broken down irretrievably for at least 6 months",
        "statute": "DRL § 170(7)",
        "notes": "Stated under oath in court papers"
      }
    ],
    "fault": [
      {
        "code": "cruel_inhuman_treatment",
        "name": "Cruel and Inhuman Treatment",
        "description": "Conduct endangering physical or mental well-being",
        "statute": "DRL § 170(1)"
      },
      {
        "code": "abandonment",
        "name": "Abandonment",
        "description": "Abandoned for 1 or more years",
        "statute": "DRL § 170(2)"
      },
      {
        "code": "imprisonment",
        "name": "Imprisonment",
        "description": "Confined in prison for 3+ consecutive years after marriage",
        "statute": "DRL § 170(3)"
      },
      {
        "code": "adultery",
        "name": "Adultery",
        "description": "Defendant committed adultery",
        "statute": "DRL § 170(4)"
      }
    ],
    "conversion": [
      {
        "code": "separation_judgment",
        "name": "Living Apart - Judgment",
        "description": "Lived apart per decree/judgment of separation for 1+ years",
        "statute": "DRL § 170(5)"
      },
      {
        "code": "separation_agreement",
        "name": "Living Apart - Agreement",
        "description": "Lived apart per written separation agreement for 1+ years",
        "statute": "DRL § 170(6)"
      }
    ]
  },

  "jointFiling": {
    "available": true,
    "effectiveDate": "January 2025",
    "description": "As of January 2025, couples can file jointly for uncontested divorce",
    "notes": "Separate packets available for with/without children under 21"
  },

  "automaticOrders": {
    "required": true,
    "description": "Automatic orders go into effect upon filing for Plaintiff and upon service for Defendant",
    "restrictions": [
      "Cannot sell, transfer, or dispose of property without consent",
      "Cannot incur unreasonable debts",
      "Cannot remove children from state without consent",
      "Cannot change insurance beneficiaries",
      "Cannot discontinue existing insurance coverage"
    ],
    "statute": "DRL § 236(B)(2)"
  },

  "formattingRequirements": {
    "paperSize": "8.5in x 11in",
    "margins": {
      "all": "1in minimum"
    },
    "font": {
      "family": "Times New Roman or similar",
      "size": "12pt minimum",
      "footnotesSize": "10pt minimum"
    },
    "spacing": "double",
    "notes": "Per CPLR 2101"
  },

  "filingFees": {
    "indexNumber": "$210",
    "rji": "$95",
    "total": "$335+",
    "varies": true,
    "notes": "Fee waiver available for qualifying individuals"
  },

  "childSupport": {
    "guidelines": "Child Support Standards Act (CSSA)",
    "ageOfMajority": 21,
    "description": "In New York, child support generally continues until age 21",
    "statute": "DRL § 240"
  },

  "maintenance": {
    "guidelines": "Maintenance Guidelines",
    "incomeCapNote": "Income cap of $228,000 for guideline calculations (as of 2024)",
    "factors": [
      "Age and health of parties",
      "Present and future earning capacity",
      "Need for education or training",
      "Standard of living during marriage",
      "Reduced earning capacity due to career sacrifice",
      "Child custody arrangements",
      "Tax consequences",
      "Duration of the marriage",
      "Loss of health insurance",
      "Any other relevant factor"
    ],
    "statute": "DRL § 236(B)(6)"
  },

  "propertyDivision": {
    "type": "equitable_distribution",
    "description": "New York is an equitable distribution state. Marital property is divided fairly, not necessarily equally.",
    "factors": [
      "Income and property at time of marriage and at commencement",
      "Duration of the marriage",
      "Age and health of both parties",
      "Need of custodial parent to occupy marital residence",
      "Loss of inheritance and pension rights",
      "Loss of health insurance",
      "Award of maintenance",
      "Direct or indirect contribution to acquiring marital property",
      "Liquid or non-liquid character of property",
      "Probable future financial circumstances",
      "Difficulty of evaluating an interest in a business",
      "Tax consequences",
      "Wasteful dissipation of assets",
      "Transfer of property made in contemplation of divorce",
      "Any other relevant factor"
    ],
    "statute": "DRL § 236(B)(5)"
  },

